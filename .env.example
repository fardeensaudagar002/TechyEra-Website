# Copy this file to .env.local for local development.
# On your host (e.g. Vercel → Project → Settings → Environment Variables) add the same names.

# Public address of the website (canonical URLs, sitemap, links in alert emails)
NEXT_PUBLIC_SITE_URL=https://www.techyera.co.in

# ---- Admin panel (/admin) -------------------------------------------------
# Password for signing in at /admin. Use 12+ characters. Required in production.
ADMIN_PASSWORD=
# Any long random string; signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=

# ---- Database -------------------------------------------------------------
# PostgreSQL connection string. Required in production.
# Leave empty on your own computer: `npm run dev` then stores data in the .data folder.
DATABASE_URL=

# ---- Email alerts (optional) ----------------------------------------------
# With these set, each new application/enquiry also sends an email via https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=hello@techyera.co.in
# Must be an address on a domain you have verified in Resend
NOTIFY_FROM=Techyera Website <website@techyera.co.in>
