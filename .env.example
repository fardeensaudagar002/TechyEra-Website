# Copy this file to .env.local for local development.
# On your host (e.g. Vercel → Project → Settings → Environment Variables) add the same names.

# Public address of the website (canonical URLs, sitemap, links in alert emails)
NEXT_PUBLIC_SITE_URL=https://www.techyera.co.in

# ---- Admin panel (/admin) -------------------------------------------------
# Password for signing in at /admin. Use 12+ characters. Required in production.
ADMIN_PASSWORD=
# Any long random string; signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=

# ---- Database -------------------------------------------------------------
# PostgreSQL connection string. Required in production.
# Leave empty on your own computer: `npm run dev` then stores data in the .data folder.
DATABASE_URL=

# ---- Email ----------------------------------------------------------------
# Turns on every email the site sends: team alerts for new enquiries/applications,
# confirmations to visitors, and application status updates from the admin panel.
# Without these, emails are recorded in the admin panel but not delivered.

# Sends through the support mailbox (GoDaddy Professional Email / Titan).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@techyera.co.in
# The mailbox password (the one used to sign in to Titan webmail). Keep it secret.
SMTP_PASS=

# Alternative to SMTP: https://resend.com (used only when the SMTP settings are empty)
RESEND_API_KEY=

# Optional. Who receives team alerts (comma-separate several). Default: support@techyera.co.in
NOTIFY_EMAIL=
# Optional. Sender name and address. Default: Techyera <SMTP_USER>. With SMTP, keep the address = SMTP_USER.
NOTIFY_FROM=
